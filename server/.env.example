# TURN never goes through Cloudflare's orange proxy.
TURN_PUBLIC_HOST=turn.pixel.neurelix.com.br
# Your public WAN IPv4. Required when coturn runs in Docker/NAT.
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=turn.pixel.neurelix.com.br
# Generate: openssl rand -base64 48
TURN_SHARED_SECRET=replace-with-a-long-random-secret
# Signal service. Used by the optional Caddy profile.
PIXEL_SIGNAL_DOMAIN=pixel-signal.neurelix.com.br
# Cloudflare Tunnel token from Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
